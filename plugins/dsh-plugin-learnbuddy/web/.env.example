# Copy to .env.local. API keys stay on the server; never prefix one with VITE_.
VITE_DATA_SOURCE=local
LEARNBUDDY_API_TARGET=http://127.0.0.1:3091
LEARNBUDDY_DSH_TARGET=http://127.0.0.1:3089
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_TEXT=deepseek-flash
LLM_MODEL_VISION=deepseek-flash
LLM_API_KEY=
# Existing shared andy-stt CLI; set the absolute path on the machine running the API.
LEARNBUDDY_STT_COMMAND=/Users/andy/.local/bin/andy-stt
LEARNBUDDY_STT_MODEL=small
LEARNBUDDY_STT_DEVICE=auto
