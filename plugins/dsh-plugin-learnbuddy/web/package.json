{
  "name": "learnbuddy-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:services": "node dev-services.mjs",
    "demo:autograder": "node ../scripts/prepare-local-autograder-demo.mjs",
    "check:llm": "node --env-file=.env.local ../scripts/verify-live-llm.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "build:dsh": "node dsh-ui/build.mjs",
    "setup:dsh": "npm install --prefix .dsh-preview/runtime --no-audit --no-fund @deepseek-ai/dsh@0.1.5-rc.1",
    "dev:dsh": "node dsh-ui/preview.mjs"
  },
  "dependencies": {
    "@radix-ui/themes": "^3.3.0",
    "lucide-react": "1.43.0",
    "motion": "^13.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
